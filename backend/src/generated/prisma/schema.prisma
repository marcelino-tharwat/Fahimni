generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                          String                       @id @default(uuid())
  fullName                    String
  email                       String                       @unique
  password                    String
  mobile                      String                       @unique
  role                        Role                         @default(STUDENT)
  status                      Status                       @default(ACTIVE)
  // Teacher lifecycle state, orthogonal to `status`. NONE for non-teachers and
  // legacy rows; teachers move PENDING_REVIEW → APPROVED | REJECTED. The derived
  // "active teacher" (APPROVED + active subscription) is not stored here.
  teacherApprovalState        TeacherApprovalState         @default(NONE)
  locale                      String                       @default("ar")
  // Defaults to true so every OTHER user-creation path in this codebase (admin
  // tooling, seeds, the ~45 e2e test fixtures that create users directly via
  // Prisma and then log in through the API) keeps working unchanged. Only the
  // public self-registration path (registerUser's student branch) explicitly
  // overrides this to false — that's the only flow this gate is meant to guard.
  emailVerified               Boolean                      @default(true)
  tokenVersion                Int                          @default(0)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  auditLogs                   AuditLog[]
  teacherRegistrationRequest  TeacherRegistrationRequest?
  createdPromoCodes           PromoCode[]                  @relation("PromoCodeCreatedBy")
  usedPromoCodes              PromoCode[]                  @relation("PromoCodeUsedBy")
  createdPlatformPromoCodes   PlatformPromoCode[]          @relation("PlatformPromoCreatedBy")
  platformPromoRedemptions    PlatformPromoRedemption[]    @relation("PlatformPromoRedeemedBy")
  enrollments                 Enrollment[]
  lessonProgress              LessonProgress[]
  otps                        Otp[]
  quizAttempts                QuizAttempt[]
  quizzes                     Quiz[]
  refreshTokens               RefreshToken[]
  stages                      Stage[]
  chaptersOwned               Chapter[]
  studentProfile              StudentProfile?
  teacherProfile              TeacherProfile?
  paymentTransactions         PaymentTransaction[]
  aiTutorUsage                AiTutorUsage[]
  aiConversations             AiConversation[]
  materialDownloads           LessonMaterialDownload[]
  teacherSubscriptions        TeacherSubscription[]
  teacherSubscriptionRequests TeacherSubscriptionRequest[]
  teacherAiUsageEvents        TeacherAiUsageEvent[]
  teacherSubscriptionPayments TeacherSubscriptionPayment[]
  notifications               Notification[]
  teacherWithdrawalRequests   TeacherWithdrawalRequest[]   @relation("TeacherWithdrawalRequests")
  reviewedWithdrawalRequests  TeacherWithdrawalRequest[]   @relation("TeacherWithdrawalReviewedBy")
}

model StudentProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  stageId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage     Stage    @relation(fields: [stageId], references: [id])

  @@index([stageId])
  @@map("student_profiles")
}

model TeacherProfile {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  subject                String?
  bio                    String?
  photoUrl               String?
  logoUrl                String?
  // STORY-65: teacher-configured daily AI-tutor question cap for this teacher's
  // students. Default 20 (matches AI_TUTOR_DAILY_QUERY_LIMIT platform default).
  aiTutorDailyQueryLimit Int       @default(20)
  // Payout profile — teacher-facing wallet withdrawal destination. Never
  // exposed to students; only the teacher (and admin, in a future admin-only
  // surface) can read/write these.
  instaPayHandle         String?
  vodafoneCashNumber     String?
  payoutMethodUpdatedAt  DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("teacher_profiles")
}

model Stage {
  id              String           @id @default(uuid())
  name            String
  nameAr          String?
  nameEn          String?
  description     String?
  descriptionAr   String?
  descriptionEn   String?
  sortOrder       Int
  teacherId       String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  chapters        Chapter[]
  studentProfiles StudentProfile[]
  teacher         User?            @relation(fields: [teacherId], references: [id])

  @@index([teacherId, sortOrder])
  @@map("stages")
}

model Chapter {
  id                  String               @id @default(uuid())
  name                String
  description         String?
  sortOrder           Int
  price               Decimal?
  imageUrl            String?
  term                AcademicTerm         @default(FIRST_TERM)
  isVisible           Boolean              @default(true)
  teacherId           String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  stageId             String
  stage               Stage                @relation(fields: [stageId], references: [id])
  teacher             User                 @relation(fields: [teacherId], references: [id])
  enrollments         Enrollment[]
  lessons             Lesson[]
  quizzes             Quiz[]
  paymentTransactions PaymentTransaction[]
  promoCodes          PromoCode[]

  @@index([stageId])
  @@index([stageId, sortOrder])
  @@index([teacherId])
  @@map("chapters")
}

model Lesson {
  id              String           @id @default(uuid())
  title           String
  description     String?
  durationMinutes Int
  youtubeUrl      String?
  sortOrder       Int
  pdfUrls         Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  chapterId       String
  deletedAt       DateTime?
  viewCount       Int              @default(0)
  requiredQuizId  String?          @map("required_quiz_id")
  lessonMaterials LessonMaterial[]
  lessonProgress  LessonProgress[]
  contentChunks   ContentChunk[]
  chapter         Chapter          @relation(fields: [chapterId], references: [id])
  quizLessons     QuizLesson[]
  requiredQuiz    Quiz?            @relation("LessonProgressionQuiz", fields: [requiredQuizId], references: [id], onDelete: SetNull)

  @@index([chapterId])
  @@index([chapterId, sortOrder])
  @@index([requiredQuizId], map: "lessons_required_quiz_id_idx")
  @@map("lessons")
}

model Otp {
  id         String    @id @default(uuid())
  code       String
  type       OtpType
  userId     String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  verifiedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otps")
}

model Enrollment {
  id            String           @id @default(uuid())
  studentId     String
  chapterId     String
  enrolledAt    DateTime         @default(now())
  status        EnrollmentStatus @default(ACTIVE)
  price         Float
  paymentMethod PaymentMethod
  promoCodeId   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  chapter       Chapter          @relation(fields: [chapterId], references: [id])
  student       User             @relation(fields: [studentId], references: [id])

  @@unique([studentId, chapterId])
  @@index([studentId])
  @@index([chapterId])
  @@map("enrollments")
}

model PaymentTransaction {
  id                  String        @id @default(uuid())
  studentId           String
  chapterId           String
  paymobOrderId       String?       @unique
  paymobTransactionId String?
  amount              Float
  currency            String        @default("EGP")
  status              PaymentStatus @default(PENDING)
  errorMessage        String?
  rawCallback         Json?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  student             User          @relation(fields: [studentId], references: [id])
  chapter             Chapter       @relation(fields: [chapterId], references: [id])

  @@index([studentId])
  @@index([chapterId])
  @@map("payment_transactions")
}

model LessonProgress {
  id        String   @id @default(uuid())
  studentId String
  lessonId  String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  student   User     @relation(fields: [studentId], references: [id])

  @@unique([studentId, lessonId])
  @@map("lesson_progress")
}

model LessonMaterial {
  id          String                   @id @default(cuid())
  lessonId    String
  filePath    String
  createdAt   DateTime                 @default(now())
  deletedAt   DateTime?
  displayName String
  fileSize    Int                      @default(0)
  mimeType    String                   @default("application/pdf")
  lesson      Lesson                   @relation(fields: [lessonId], references: [id])
  downloads   LessonMaterialDownload[]

  @@index([lessonId])
  @@map("lesson_materials")
}

model LessonMaterialDownload {
  id                String         @id @default(cuid())
  studentId         String         @map("student_id")
  materialId        String         @map("material_id")
  firstDownloadedAt DateTime       @default(now()) @map("first_downloaded_at")
  lastDownloadedAt  DateTime       @updatedAt @map("last_downloaded_at")
  student           User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  material          LessonMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([studentId, materialId])
  @@index([materialId])
  @@index([studentId])
  @@map("lesson_material_downloads")
}

model ContentChunk {
  id        String                       @id @default(uuid())
  content   String
  embedding Unsupported("vector(3072)")?
  lessonId  String
  metadata  Json                         @default("{}")
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt
  lesson    Lesson                       @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("content_chunks")
}

/// STORY-64: per-student daily AI-tutor query accounting. One row per student
/// per UTC calendar day; the unique constraint enables an atomic claim/refund so
/// concurrent requests cannot exceed AI_TUTOR_DAILY_QUERY_LIMIT.
model AiTutorUsage {
  id        String   @id @default(uuid())
  studentId String
  usageDate DateTime @db.Date
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, usageDate])
  @@index([studentId])
  @@map("ai_tutor_usage")
}

model AuditLog {
  id             String   @id @default(uuid())
  action         String
  resourceType   String
  resourceId     String
  details        Json?
  userId         String
  createdAt      DateTime @default(now())
  actorType      String?
  actorName      String?
  scopeTeacherId String?
  user           User     @relation(fields: [userId], references: [id])

  @@index([scopeTeacherId, createdAt])
  @@index([userId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

model EmailLog {
  id                String         @id @default(uuid())
  to                String
  subject           String
  template          String
  locale            String
  status            EmailLogStatus
  providerMessageId String?
  entityType        String?
  entityId          String?
  dedupeKey         String?        @unique
  errorMessage      String?
  metadata          Json?
  createdAt         DateTime       @default(now())
  sentAt            DateTime?

  @@index([template, createdAt])
  @@index([status, createdAt])
  @@index([locale, createdAt])
  @@index([entityType, entityId])
  @@map("email_logs")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  createdAt DateTime @default(now())
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Quiz {
  id                       String                  @id @default(uuid())
  title                    String
  description              String?
  chapterId                String?
  contentScope             QuizContentScope        @default(CHAPTER) @map("content_scope")
  // ── Generation source scope (additive, orthogonal to contentScope) ─────────
  // contentScope (CHAPTER vs SELECTED_LESSONS) describes intra-chapter lesson
  // placement. sourceScope describes how many chapters/stages the questions were
  // generated FROM (single chapter, several chapters, or a whole stage). Defaults
  // keep every legacy row valid: SINGLE_CHAPTER, empty chapter list, no stage.
  sourceScope              QuizSourceScope         @default(SINGLE_CHAPTER) @map("source_scope")
  sourceChapterIds         String[]                @default([]) @map("source_chapter_ids")
  sourceStageId            String?                 @map("source_stage_id")
  status                   QuizStatus              @default(DRAFT)
  durationMinutes          Int?                    @map("duration_minutes")
  questionCount            Int                     @default(0)
  totalPoints              Int                     @default(0)
  passingScore             Int?                    @map("passing_score")
  createdBy                String
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  publishedAt              DateTime?
  // ── Result visibility settings (additive, opt-in) ──────────────────────
  // resultSettingsConfigured=false (default) => legacy behavior: the student
  // result endpoint returns the full response exactly as before. When a teacher
  // saves settings the flag flips to true and the nullable columns below take
  // effect. Nullable booleans are resolved to safe defaults in the policy layer.
  resultSettingsConfigured Boolean                 @default(false) @map("result_settings_configured")
  showCorrectAnswers       Boolean?                @map("show_correct_answers")
  showPerQuestionScores    Boolean?                @map("show_per_question_scores")
  showFinalScore           Boolean?                @map("show_final_score")
  showStudentAnswers       Boolean?                @map("show_student_answers")
  showExplanations         Boolean?                @map("show_explanations")
  pendingEssayResultMode   PendingEssayResultMode? @map("pending_essay_result_mode")
  questions                Question[]
  attempts                 QuizAttempt[]
  quizLessons              QuizLesson[]
  progressionGateLessons   Lesson[]                @relation("LessonProgressionQuiz")
  chapter                  Chapter?                @relation(fields: [chapterId], references: [id])
  creator                  User                    @relation(fields: [createdBy], references: [id])

  @@index([chapterId, status])
  @@map("quizzes")
}

model QuizLesson {
  quizId   String
  lessonId String
  quiz     Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  lesson   Lesson @relation(fields: [lessonId], references: [id])

  @@id([quizId, lessonId])
  @@index([lessonId])
  @@map("quiz_lessons")
}

enum QuizContentScope {
  CHAPTER
  SELECTED_LESSONS
}

enum QuizSourceScope {
  SINGLE_CHAPTER
  MULTI_CHAPTER
  FULL_CURRICULUM
}

/// Controls what a student sees on the result page while a quiz still has
/// essay answers awaiting teacher review. Additive; only consulted when
/// Quiz.resultSettingsConfigured is true.
enum PendingEssayResultMode {
  HIDE_ALL_RESULTS
  SHOW_OBJECTIVE_ONLY
  SHOW_OBJECTIVE_WITH_PENDING_MESSAGE
}

model Question {
  id            String       @id @default(uuid())
  quizId        String
  type          QuestionType
  text          String
  options       Json
  correctAnswer String?
  explanation   String?
  sortOrder     Int          @default(0)
  points        Int          @default(1)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([quizId, sortOrder])
  @@map("questions")
}

model QuizAttempt {
  id                      String                   @id @default(uuid())
  quizId                  String
  studentId               String
  answers                 Json
  score                   Float?
  totalPoints             Int                      @default(0)
  status                  AttemptStatus            @default(IN_PROGRESS)
  startedAt               DateTime                 @default(now())
  completedAt             DateTime?
  durationMinutesSnapshot Int?                     @map("duration_minutes_snapshot")
  expiresAt               DateTime?                @map("expires_at")
  submissionReason        AttemptSubmissionReason? @map("submission_reason")
  lastSavedAt             DateTime?                @map("last_saved_at")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  quiz                    Quiz                     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student                 User                     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([quizId, studentId])
  @@index([studentId])
  @@index([quizId])
  @@map("quiz_attempts")
}

model PromoCode {
  id              String    @id @default(uuid())
  code            String    @unique @db.VarChar(8)
  isUsed          Boolean   @default(false)
  usedByStudentId String?
  usedAt          DateTime?
  createdById     String
  chapterId       String
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?
  usedByStudent   User?     @relation("PromoCodeUsedBy", fields: [usedByStudentId], references: [id])
  createdBy       User      @relation("PromoCodeCreatedBy", fields: [createdById], references: [id])
  chapter         Chapter   @relation(fields: [chapterId], references: [id])

  @@index([usedByStudentId])
  @@index([createdById])
  @@index([chapterId])
  @@map("promo_codes")
}

/// Admin-managed, scope-separated discount promo codes. Distinct from the
/// single-use, chapter-bound `PromoCode` above (teacher-generated free-enrollment
/// codes, left untouched). COURSE_PURCHASE codes apply only to student course
/// checkout; TEACHER_PLAN codes apply only to teacher subscription checkout —
/// never cross-used. All discount math is computed server-side.
enum PromoScope {
  COURSE_PURCHASE
  TEACHER_PLAN
}

enum PromoDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

/// Billing intervals a TEACHER_PLAN promo may apply to (ALL = both).
enum PromoBillingScope {
  MONTHLY
  YEARLY
  ALL
}

enum AcademicTerm {
  FIRST_TERM
  SECOND_TERM
}

model PlatformPromoCode {
  id                String                    @id @default(uuid())
  code              String                    @unique
  scope             PromoScope
  discountType      PromoDiscountType
  discountValue     Float
  currency          String                    @default("EGP")
  startsAt          DateTime?
  expiresAt         DateTime?
  isActive          Boolean                   @default(true)
  maxUses           Int?
  usedCount         Int                       @default(0)
  perUserLimit      Int?
  /// TEACHER_PLAN only: restrict to these plan ids (empty = all plans).
  applicablePlanIds String[]                  @default([])
  billingInterval   PromoBillingScope         @default(ALL)
  createdById       String
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  createdBy         User                      @relation("PlatformPromoCreatedBy", fields: [createdById], references: [id])
  redemptions       PlatformPromoRedemption[]

  @@index([scope, isActive])
  @@map("platform_promo_codes")
}

/// One redemption of a PlatformPromoCode by a user (drives usedCount + perUserLimit).
model PlatformPromoRedemption {
  id           String            @id @default(uuid())
  promoCodeId  String
  userId       String
  amountBefore Float
  discount     Float
  amountAfter  Float
  createdAt    DateTime          @default(now())
  promoCode    PlatformPromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  user         User              @relation("PlatformPromoRedeemedBy", fields: [userId], references: [id])

  @@index([promoCodeId])
  @@index([userId])
  @@index([promoCodeId, userId])
  @@map("platform_promo_redemptions")
}

enum Role {
  ADMIN
  STUDENT
  OPERATION
}

enum Status {
  ACTIVE
  INACTIVE
  BANNED
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  ESSAY
}

enum QuizStatus {
  DRAFT
  PUBLISHED
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  GRADED
}

enum AttemptSubmissionReason {
  MANUAL
  TIME_EXPIRED
}

enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum EmailLogStatus {
  QUEUED
  SENT
  FAILED
  DRY_RUN
  SKIPPED_DUPLICATE
}

enum EnrollmentStatus {
  ACTIVE
  DEACTIVATED
  PAYMENT_PENDING
}

enum PaymentMethod {
  FREE
  PROMO
  PAYMOB
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum NotificationType {
  NEW_LESSON
  NEW_QUIZ
}

model Notification {
  id              String           @id @default(uuid())
  studentId       String
  type            NotificationType
  resourceTitle   String
  resourceType    String
  resourceId      String
  courseContextId String?
  isRead          Boolean          @default(false)
  createdAt       DateTime         @default(now())
  student         User             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, isRead, createdAt])
  @@index([studentId, createdAt])
  @@map("notifications")
}

enum TeacherRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RejectionMode {
  EDIT_ALLOWED
  FINAL_REJECTION
}

/// Teacher account lifecycle, orthogonal to User.status. NONE for non-teachers
/// and legacy rows. Teachers created via unified registration start
/// PENDING_REVIEW; admin approval sets APPROVED, rejection sets REJECTED.
enum TeacherApprovalState {
  NONE
  PENDING_REVIEW
  APPROVED
  REJECTED
}

/// Prospective teacher applications submitted for admin review.
model TeacherRegistrationRequest {
  id              String               @id @default(uuid())
  publicReference String               @unique
  fullName        String
  email           String
  mobile          String
  subject         String?
  bio             String?
  status          TeacherRequestStatus @default(PENDING)
  /// JSON array of {originalName, mimeType, size, path}
  proofDocuments  Json                 @default("[]")
  adminNotes      String?
  /// EDIT_ALLOWED | FINAL_REJECTION — only set when status = REJECTED
  rejectionMode   RejectionMode?
  reviewedById    String?
  reviewedAt      DateTime?
  // Optional link to the pending OPERATION user created at unified registration.
  // Null for legacy requests (public /become-teacher form, which creates no user).
  userId          String?              @unique
  user            User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([mobile])
  @@map("teacher_registration_requests")
}

/// STORY-69 — persistent AI tutor conversations owned by a student.
model AiConversation {
  id         String      @id @default(uuid())
  studentId  String
  title      String      @default("محادثة جديدة")
  isArchived Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?
  student    User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  messages   AiMessage[]

  @@index([studentId, updatedAt])
  @@map("ai_conversations")
}

/// STORY-69 — persisted tutor chat messages (text + citation metadata).
model AiMessage {
  id              String          @id @default(uuid())
  conversationId  String
  role            AiMessageRole
  content         String
  status          AiMessageStatus @default(PENDING)
  citations       Json            @default("[]")
  clientMessageId String?
  errorCode       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  conversation    AiConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

enum AiMessageRole {
  STUDENT
  ASSISTANT
}

enum AiMessageStatus {
  PENDING
  COMPLETED
  FAILED
}

// ── Teacher Plans / Subscriptions ─────────────────────────────────────

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum SubscriptionRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum AiUsageType {
  AI_QUIZ_GENERATION
  AI_ESSAY_GRADING
  AI_CONTENT_GENERATION
  AI_LESSON_SUMMARY
  AI_QUESTION_EXPLANATION
}

/// Teacher-visible subscription plan tier. Source of truth for feature
/// access and usage limits. Seeded idempotently — never deleted at runtime.
model TeacherPlan {
  id              String                       @id @default(uuid())
  code            String                       @unique
  name            String
  displayName     String
  description     String?
  monthlyPrice    Float                        @default(0)
  yearlyPrice     Float?
  currency        String                       @default("EGP")
  billingInterval BillingInterval              @default(MONTHLY)
  isActive        Boolean                      @default(true)
  isRecommended   Boolean                      @default(false)
  sortOrder       Int                          @default(0)
  /// JSON object keyed by feature code (e.g. aiQuizGeneration).
  features        Json                         @default("{}")
  /// JSON object keyed by limit name (e.g. aiQuizGenerationsPerMonth).
  limits          Json                         @default("{}")
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  subscriptions   TeacherSubscription[]
  requests        TeacherSubscriptionRequest[]
  usageEvents     TeacherAiUsageEvent[]
  payments        TeacherSubscriptionPayment[]

  @@index([isActive, sortOrder])
  @@map("teacher_plans")
}

/// A teacher's active or historical subscription. At most one ACTIVE or
/// TRIALING subscription per teacher. ACTIVE is only set after confirmed
/// payment or admin approval — never by the teacher frontend.
model TeacherSubscription {
  id                 String                       @id @default(uuid())
  teacherId          String
  planId             String
  status             SubscriptionStatus           @default(TRIALING)
  billingInterval    BillingInterval              @default(MONTHLY)
  startedAt          DateTime                     @default(now())
  currentPeriodStart DateTime                     @default(now())
  currentPeriodEnd   DateTime
  cancelledAt        DateTime?
  trialEndsAt        DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  teacher            User                         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  plan               TeacherPlan                  @relation(fields: [planId], references: [id])
  usageEvents        TeacherAiUsageEvent[]
  payments           TeacherSubscriptionPayment[]

  @@index([teacherId])
  @@index([teacherId, status])
  @@index([planId])
  @@map("teacher_subscriptions")
}

/// A teacher-initiated request to subscribe, upgrade, or change plan.
/// Created as PENDING; only admin approval can set to APPROVED.
model TeacherSubscriptionRequest {
  id                String                    @id @default(uuid())
  teacherId         String
  planId            String
  requestedInterval BillingInterval           @default(MONTHLY)
  status            SubscriptionRequestStatus @default(PENDING)
  adminNotes        String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  teacher           User                      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  plan              TeacherPlan               @relation(fields: [planId], references: [id])

  @@index([teacherId])
  @@index([teacherId, status])
  @@index([planId])
  @@map("teacher_subscription_requests")
}

/// Immutable audit log of a teacher AI usage event. Written server-side
/// only after the AI operation succeeds. Used for quota enforcement.
model TeacherAiUsageEvent {
  id             String               @id @default(uuid())
  teacherId      String
  subscriptionId String?
  planId         String?
  usageType      AiUsageType
  units          Int                  @default(1)
  /// Free-form metadata — e.g. { quizId, questionCount, essayCount }.
  metadata       Json?
  createdAt      DateTime             @default(now())
  teacher        User                 @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subscription   TeacherSubscription? @relation(fields: [subscriptionId], references: [id])
  plan           TeacherPlan?         @relation(fields: [planId], references: [id])

  @@index([teacherId])
  @@index([teacherId, usageType, createdAt])
  @@index([subscriptionId])
  @@index([planId])
  @@map("teacher_ai_usage_events")
}

/// Tracks a teacher's plan-subscription payment through the payment provider
/// (Paymob). A TeacherSubscription is created/activated ONLY after the matching
/// payment row reaches SUCCESS via the HMAC-verified provider webhook — never
/// optimistically on checkout. Reuses PaymentStatus (PENDING/SUCCESS/FAILED).
model TeacherSubscriptionPayment {
  id                    String               @id @default(uuid())
  teacherId             String
  planId                String
  /// Set once the payment succeeds and a subscription is created/activated.
  subscriptionId        String?
  provider              String               @default("PAYMOB")
  providerOrderId       String?              @unique
  providerTransactionId String?
  amount                Float
  currency              String               @default("EGP")
  billingInterval       BillingInterval      @default(MONTHLY)
  status                PaymentStatus        @default(PENDING)
  checkoutUrl           String?
  errorMessage          String?
  /// Raw provider callback — server-only; never returned by normal APIs.
  rawCallback           Json?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  teacher               User                 @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  plan                  TeacherPlan          @relation(fields: [planId], references: [id])
  subscription          TeacherSubscription? @relation(fields: [subscriptionId], references: [id])

  @@index([teacherId])
  @@index([teacherId, status])
  @@index([planId])
  @@index([subscriptionId])
  @@map("teacher_subscription_payments")
}

enum TeacherWithdrawalStatus {
  PENDING
  PROCESSING
  TRANSFERRED
  REJECTED
  CANCELLED
}

/// A teacher's request to withdraw money from their earned wallet balance.
/// Created/processed by admin (out of scope for this feature); the teacher can
/// only read their own requests. Balance math (available/held/transferred) is
/// always DERIVED from these rows + SUCCESS PaymentTransaction rows — never
/// manually edited.
model TeacherWithdrawalRequest {
  id                   String                  @id @default(uuid())
  teacherId            String
  amount               Float
  currency             String                  @default("EGP")
  status               TeacherWithdrawalStatus @default(PENDING)
  /// Payout destination at the time of the request (safe fields only — no
  /// provider secrets). Snapshot so a later payout-profile edit doesn't alter
  /// the historical record of where this payout was sent.
  payoutMethodSnapshot Json?
  teacherNote          String?
  adminNote            String?
  requestedAt          DateTime                @default(now())
  processedAt          DateTime?
  transferredAt        DateTime?
  cancelledAt          DateTime?
  reviewedById         String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  teacher              User                    @relation("TeacherWithdrawalRequests", fields: [teacherId], references: [id], onDelete: Cascade)
  reviewedBy           User?                   @relation("TeacherWithdrawalReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([teacherId])
  @@index([teacherId, status])
  @@map("teacher_withdrawal_requests")
}
