generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid())
  fullName            String
  email               String               @unique
  password            String
  mobile              String               @unique
  role                Role                 @default(STUDENT)
  status              Status               @default(ACTIVE)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  auditLogs           AuditLog[]
  createdPromoCodes   PromoCode[]          @relation("PromoCodeCreatedBy")
  usedPromoCodes      PromoCode[]          @relation("PromoCodeUsedBy")
  enrollments         Enrollment[]
  lessonProgress      LessonProgress[]
  otps                Otp[]
  quizAttempts        QuizAttempt[]
  quizzes             Quiz[]
  refreshTokens       RefreshToken[]
  stages              Stage[]
  studentProfile      StudentProfile?
  teacherProfile      TeacherProfile?
  paymentTransactions PaymentTransaction[]
  aiTutorUsage        AiTutorUsage[]
}

model StudentProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model TeacherProfile {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  subject                String?
  bio                    String?
  photoUrl               String?
  logoUrl                String?
  // STORY-65: teacher-configured daily AI-tutor question cap for this teacher's
  // students. Default 20 (matches AI_TUTOR_DAILY_QUERY_LIMIT platform default).
  aiTutorDailyQueryLimit Int      @default(20)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("teacher_profiles")
}

model Stage {
  id          String    @id @default(uuid())
  name        String
  description String?
  sortOrder   Int
  teacherId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  chapters    Chapter[]
  teacher     User      @relation(fields: [teacherId], references: [id])

  @@index([teacherId, sortOrder])
  @@map("stages")
}

model Chapter {
  id                  String               @id @default(uuid())
  name                String
  description         String?
  sortOrder           Int
  price               Decimal?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  stageId             String
  stage               Stage                @relation(fields: [stageId], references: [id])
  enrollments         Enrollment[]
  lessons             Lesson[]
  quizzes             Quiz[]
  paymentTransactions PaymentTransaction[]
  promoCodes          PromoCode[]

  @@index([stageId])
  @@index([stageId, sortOrder])
  @@map("chapters")
}

model Lesson {
  id              String           @id @default(uuid())
  title           String
  description     String?
  durationMinutes Int
  youtubeUrl      String?
  sortOrder       Int
  pdfUrls         Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  chapterId       String
  deletedAt       DateTime?
  viewCount       Int              @default(0)
  lessonMaterials LessonMaterial[]
  lessonProgress  LessonProgress[]
  contentChunks   ContentChunk[]
  chapter         Chapter          @relation(fields: [chapterId], references: [id])

  @@index([chapterId])
  @@index([chapterId, sortOrder])
  @@map("lessons")
}

model Otp {
  id         String    @id @default(uuid())
  code       String
  type       OtpType
  userId     String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  verifiedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otps")
}

model Enrollment {
  id            String           @id @default(uuid())
  studentId     String
  chapterId     String
  enrolledAt    DateTime         @default(now())
  status        EnrollmentStatus @default(ACTIVE)
  price         Float
  paymentMethod PaymentMethod
  promoCodeId   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  chapter       Chapter          @relation(fields: [chapterId], references: [id])
  student       User             @relation(fields: [studentId], references: [id])

  @@unique([studentId, chapterId])
  @@index([studentId])
  @@index([chapterId])
  @@map("enrollments")
}

model PaymentTransaction {
  id                  String        @id @default(uuid())
  studentId           String
  chapterId           String
  paymobOrderId       String?       @unique
  paymobTransactionId String?
  amount              Float
  currency            String        @default("EGP")
  status              PaymentStatus @default(PENDING)
  errorMessage        String?
  rawCallback         Json?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  student             User          @relation(fields: [studentId], references: [id])
  chapter             Chapter       @relation(fields: [chapterId], references: [id])

  @@index([studentId])
  @@index([chapterId])
  @@map("payment_transactions")
}

model LessonProgress {
  id        String   @id @default(uuid())
  studentId String
  lessonId  String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  student   User     @relation(fields: [studentId], references: [id])

  @@unique([studentId, lessonId])
  @@map("lesson_progress")
}

model LessonMaterial {
  id          String    @id @default(cuid())
  lessonId    String
  filePath    String
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  displayName String
  fileSize    Int       @default(0)
  mimeType    String    @default("application/pdf")
  lesson      Lesson    @relation(fields: [lessonId], references: [id])

  @@index([lessonId])
  @@map("lesson_materials")
}

model ContentChunk {
  id        String                       @id @default(uuid())
  content   String
  embedding Unsupported("vector(3072)")?
  lessonId  String
  metadata  Json                         @default("{}")
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt
  lesson    Lesson                       @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("content_chunks")
}

/// STORY-64: per-student daily AI-tutor query accounting. One row per student
/// per UTC calendar day; the unique constraint enables an atomic claim/refund so
/// concurrent requests cannot exceed AI_TUTOR_DAILY_QUERY_LIMIT.
model AiTutorUsage {
  id        String   @id @default(uuid())
  studentId String
  usageDate DateTime @db.Date
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, usageDate])
  @@index([studentId])
  @@map("ai_tutor_usage")
}

model AuditLog {
  id             String   @id @default(uuid())
  action         String
  resourceType   String
  resourceId     String
  details        Json?
  userId         String
  createdAt      DateTime @default(now())
  actorType      String?
  actorName      String?
  scopeTeacherId String?
  user           User     @relation(fields: [userId], references: [id])

  @@index([scopeTeacherId, createdAt])
  @@index([userId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  createdAt DateTime @default(now())
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Quiz {
  id              String        @id @default(uuid())
  title           String
  description     String?
  chapterId       String?
  status          QuizStatus    @default(DRAFT)
  durationMinutes Int?          @map("duration_minutes")
  questionCount   Int           @default(0)
  totalPoints     Int           @default(0)
  createdBy       String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  publishedAt     DateTime?
  questions       Question[]
  attempts        QuizAttempt[]
  chapter         Chapter?      @relation(fields: [chapterId], references: [id])
  creator         User          @relation(fields: [createdBy], references: [id])

  @@index([chapterId, status])
  @@map("quizzes")
}

model Question {
  id            String       @id @default(uuid())
  quizId        String
  type          QuestionType
  text          String
  options       Json
  correctAnswer String?
  explanation   String?
  sortOrder     Int          @default(0)
  points        Int          @default(1)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([quizId, sortOrder])
  @@map("questions")
}

model QuizAttempt {
  id          String        @id @default(uuid())
  quizId      String
  studentId   String
  answers     Json
  score       Float?
  totalPoints Int           @default(0)
  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  quiz        Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student     User          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([quizId, studentId])
  @@index([studentId])
  @@index([quizId])
  @@map("quiz_attempts")
}

model PromoCode {
  id              String    @id @default(uuid())
  code            String    @unique @db.VarChar(8)
  isUsed          Boolean   @default(false)
  usedByStudentId String?
  usedAt          DateTime?
  createdById     String
  chapterId       String
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?
  usedByStudent   User?     @relation("PromoCodeUsedBy", fields: [usedByStudentId], references: [id])
  createdBy       User      @relation("PromoCodeCreatedBy", fields: [createdById], references: [id])
  chapter         Chapter   @relation(fields: [chapterId], references: [id])

  @@index([usedByStudentId])
  @@index([createdById])
  @@index([chapterId])
  @@map("promo_codes")
}

enum Role {
  ADMIN
  STUDENT
  OPERATION
}

enum Status {
  ACTIVE
  INACTIVE
  BANNED
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  ESSAY
}

enum QuizStatus {
  DRAFT
  PUBLISHED
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  GRADED
}

enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum EnrollmentStatus {
  ACTIVE
  DEACTIVATED
  PAYMENT_PENDING
}

enum PaymentMethod {
  CASH
  VISA
  PROMO
  PAYMOB
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}
