# ─── Server ────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database (PostgreSQL) ─────────────────────────────────────────────
# Host port 15432 maps to the container's 5432 (see backend/docker-compose.yml).
DATABASE_URL=postgresql://postgres:postgres@localhost:15432/final_project
# Isolated database for E2E tests (npm run test:e2e:*). Must be LOCAL and separate
# from DATABASE_URL; the E2E setup refuses non-local hosts.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:15432/final_project_test

# ─── JWT ───────────────────────────────────────────────────────────────
# Generate secrets with: openssl rand -hex 64
JWT_SECRET=c66ac89e1c4b47d11bf1f60041ddedae23d82408529cbd7daf3c126c48bdbad2aa
JWT_REFRESH_SECRET=d7cab85c137d8162bee4e0f1a7828f6ca108f4353900145fc1933e1b678f1c52bb
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Default admin (seeded) ────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123456
ADMIN_FULL_NAME=System Administrator
ADMIN_MOBILE=01000000000

# ─── Cloudinary (media storage) ────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Supabase Storage ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET_NAME=lesson-materials

# ─── Email (SMTP) ──────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM="Fahimni <your-email@gmail.com>"

# ─── Client ────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Gemini ────────────────────────────────────────────────────────────
# This project uses Gemini via its own client (src/shared/services/geminiClient.ts),
# not the Vertex AI SDK. Required at startup (validated in src/config/env.ts).
GEMINI_API_KEY=your_gemini_api_key_here
# Generation/embedding models (defaults: gemini-2.0-flash / text-embedding-004).
GEMINI_GENERATION_MODEL=gemini-3.1-pro-preview
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# STORY-45 AI quiz generation timeouts are fixed code constants, not env vars:
#   total request budget = 25s, Gemini generation call = 20s.

# ─── Local seed (development only) ──────────────────────────────────────
# Deterministic password used by prisma/seed.ts for the local test accounts.
# Set a value in your local (git-ignored) .env. Never commit a real value here.
# SEED_LOCAL_PASSWORD=change-me-local-only
# Optional: SEED_AI_READY=true  (indexes the successful chapter via Gemini)