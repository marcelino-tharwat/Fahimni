# ─── Server ─────────────────────────────────────────────────────────────
# Port the Express server listens on
PORT=3000
# Node environment: development | production | test
NODE_ENV=development

# ─── Database (PostgreSQL) ──────────────────────────────────────────────
# Connection string for Prisma / PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/YOUR_DATABASE

# ─── JWT ────────────────────────────────────────────────────────────────
# Secret for signing access tokens
# Generate with: openssl rand -hex 64
JWT_SECRET=YOUR_JWT_ACCESS_SECRET

# Secret for signing refresh tokens (must be different from JWT_SECRET)
# Generate with: openssl rand -hex 64
JWT_REFRESH_SECRET=YOUR_JWT_REFRESH_SECRET

# Access token expiry (e.g. 15m, 1h, 7d)
JWT_EXPIRES_IN=15m

# Refresh token expiry (e.g. 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# ─── Default Admin (seeded) ─────────────────────────────────────────────
# Credentials for the admin user created by prisma/seed.ts
ADMIN_EMAIL=admin@YOUR_DOMAIN.com
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD
ADMIN_FULL_NAME=System Administrator
ADMIN_MOBILE=01000000000

# ─── Email / SMTP ──────────────────────────────────────────────────────
# SMTP configuration for transactional emails (OTP, notifications)
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-email@example.com
SMTP_PASS=YOUR_SMTP_PASSWORD

# ─── Cloudinary (media storage) ─────────────────────────────────────────
# Get credentials from: https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# ─── Supabase Storage ───────────────────────────────────────────────────
# Supabase project URL and service-role key for file uploads
# Get from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_BUCKET_NAME=YOUR_BUCKET_NAME

# ─── Email (alternative / legacy) ───────────────────────────────────────
# Alternative email configuration (currently unused, kept for reference)
EMAIL_HOST=smtp.your-email-provider.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=YOUR_EMAIL_PASSWORD
EMAIL_FROM="Your App Name <your-email@example.com>"

# ─── Client ─────────────────────────────────────────────────────────────
# Frontend URL for CORS and redirect links
CLIENT_URL=http://localhost:5173
