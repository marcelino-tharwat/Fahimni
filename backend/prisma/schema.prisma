generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STUDENT
  OPERATION
}

enum Status {
  ACTIVE
  INACTIVE
  BANNED
}

model User {
  id             String          @id @default(uuid())
  fullName       String
  email          String          @unique
  password       String
  mobile         String          @unique
  role           Role            @default(STUDENT)
  status         Status          @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  refreshTokens  RefreshToken[]
  otps           Otp[]
  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  stages         Stage[]
  auditLogs      AuditLog[]
  enrollments    Enrollment[]
  lessonProgress LessonProgress[]
}

model StudentProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("student_profiles")
}

model TeacherProfile {
  id       String  @id @default(uuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject  String?
  bio      String?
  photoUrl String?
  logoUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("teacher_profiles")
}

model Stage {
  id          String    @id @default(uuid())
  name        String
  description String?
  sortOrder   Int
  teacherId   String
  teacher     User      @relation(fields: [teacherId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  chapters    Chapter[]

  @@index([teacherId, sortOrder])
  @@map("stages")
}

model Chapter {
  id          String    @id @default(uuid())
  name        String
  description String?
  sortOrder   Int
  price       Decimal? // null = free chapter 
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  stageId     String
  stage       Stage     @relation(fields: [stageId], references: [id])
  lessons     Lesson[]
  enrollments Enrollment[]

  @@index([stageId])
  @@index([stageId, sortOrder])
  @@map("chapters")
}

model Lesson {
  id              String    @id @default(uuid())
  title           String
  description     String?
  durationMinutes Int
  youtubeUrl      String?
  sortOrder       Int
  pdfUrls         Json? // array of S3 object keys
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  chapterId       String
  chapter         Chapter   @relation(fields: [chapterId], references: [id])
  lessonProgress  LessonProgress[]

  @@index([chapterId])
  @@index([chapterId, sortOrder])
  @@map("lessons")
}

enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model Otp {
  id         String    @id @default(uuid())
  code       String
  type       OtpType
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  verifiedAt DateTime?
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@map("otps")
}

model Enrollment {
  id        String   @id @default(uuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id])
  chapterId String
  chapter   Chapter  @relation(fields: [chapterId], references: [id])
  enrolledAt DateTime @default(now())
  status    String   @default("ACTIVE")

  @@unique([studentId, chapterId])
  @@map("enrollments")
}

model LessonProgress {
  id        String   @id @default(uuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id])
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, lessonId])
  @@map("lesson_progress")
}

model LessonMaterial {
  id        String    @id @default(cuid())
  lessonId  String
  filePath  String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@map("lesson_materials")
}

model AuditLog {
  id           String   @id @default(uuid())
  action       String
  resourceType String
  resourceId   String
  details      Json?
  // userId is the ACTOR who performed the action (teacher or student).
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  // actorType describes the actor independently of role enums (e.g. TEACHER, STUDENT, SYSTEM).
  actorType    String?
  // actorName is a denormalized display name, captured at write time so the
  // activity feed can render student-generated events without an extra join.
  actorName    String?
  // scopeTeacherId is the teacher whose dashboard/activity stream should
  // surface this event. For teacher-authored content actions it equals userId;
  // for student-generated events (e.g. quiz completed) it is the owning teacher.
  scopeTeacherId String?
  createdAt    DateTime @default(now())

  @@index([scopeTeacherId, createdAt])
  @@index([userId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}
