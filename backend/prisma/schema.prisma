generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                   @id @default(uuid())
  fullName            String
  email               String                   @unique
  password            String
  mobile              String                   @unique
  role                Role                     @default(STUDENT)
  status              Status                   @default(ACTIVE)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  auditLogs           AuditLog[]
  createdPromoCodes   PromoCode[]              @relation("PromoCodeCreatedBy")
  usedPromoCodes      PromoCode[]              @relation("PromoCodeUsedBy")
  enrollments         Enrollment[]
  lessonProgress      LessonProgress[]
  otps                Otp[]
  quizAttempts        QuizAttempt[]
  quizzes             Quiz[]
  refreshTokens       RefreshToken[]
  stages              Stage[]
  studentProfile      StudentProfile?
  teacherProfile      TeacherProfile?
  paymentTransactions PaymentTransaction[]
  aiTutorUsage        AiTutorUsage[]
  aiConversations     AiConversation[]
  materialDownloads   LessonMaterialDownload[]
}

model StudentProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  stageId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage     Stage    @relation(fields: [stageId], references: [id])

  @@index([stageId])
  @@map("student_profiles")
}

model TeacherProfile {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  subject                String?
  bio                    String?
  photoUrl               String?
  logoUrl                String?
  // STORY-65: teacher-configured daily AI-tutor question cap for this teacher's
  // students. Default 20 (matches AI_TUTOR_DAILY_QUERY_LIMIT platform default).
  aiTutorDailyQueryLimit Int      @default(20)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("teacher_profiles")
}

model Stage {
  id              String           @id @default(uuid())
  name            String
  description     String?
  sortOrder       Int
  teacherId       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  chapters        Chapter[]
  studentProfiles StudentProfile[]
  teacher         User             @relation(fields: [teacherId], references: [id])

  @@index([teacherId, sortOrder])
  @@map("stages")
}

model Chapter {
  id                  String               @id @default(uuid())
  name                String
  description         String?
  sortOrder           Int
  price               Decimal?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  stageId             String
  stage               Stage                @relation(fields: [stageId], references: [id])
  enrollments         Enrollment[]
  lessons             Lesson[]
  quizzes             Quiz[]
  paymentTransactions PaymentTransaction[]
  promoCodes          PromoCode[]

  @@index([stageId])
  @@index([stageId, sortOrder])
  @@map("chapters")
}

model Lesson {
  id              String           @id @default(uuid())
  title           String
  description     String?
  durationMinutes Int
  youtubeUrl      String?
  sortOrder       Int
  pdfUrls         Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  chapterId       String
  deletedAt       DateTime?
  viewCount       Int              @default(0)
  requiredQuizId  String?          @map("required_quiz_id")
  lessonMaterials LessonMaterial[]
  lessonProgress  LessonProgress[]
  contentChunks   ContentChunk[]
  chapter         Chapter          @relation(fields: [chapterId], references: [id])
  quizLessons     QuizLesson[]
  requiredQuiz    Quiz?            @relation("LessonProgressionQuiz", fields: [requiredQuizId], references: [id], onDelete: SetNull)

  @@index([chapterId])
  @@index([chapterId, sortOrder])
  @@index([requiredQuizId], map: "lessons_required_quiz_id_idx")
  @@map("lessons")
}

model Otp {
  id         String    @id @default(uuid())
  code       String
  type       OtpType
  userId     String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  verifiedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otps")
}

model Enrollment {
  id            String           @id @default(uuid())
  studentId     String
  chapterId     String
  enrolledAt    DateTime         @default(now())
  status        EnrollmentStatus @default(ACTIVE)
  price         Float
  paymentMethod PaymentMethod
  promoCodeId   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  chapter       Chapter          @relation(fields: [chapterId], references: [id])
  student       User             @relation(fields: [studentId], references: [id])

  @@unique([studentId, chapterId])
  @@index([studentId])
  @@index([chapterId])
  @@map("enrollments")
}

model PaymentTransaction {
  id                  String        @id @default(uuid())
  studentId           String
  chapterId           String
  paymobOrderId       String?       @unique
  paymobTransactionId String?
  amount              Float
  currency            String        @default("EGP")
  status              PaymentStatus @default(PENDING)
  errorMessage        String?
  rawCallback         Json?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  student             User          @relation(fields: [studentId], references: [id])
  chapter             Chapter       @relation(fields: [chapterId], references: [id])

  @@index([studentId])
  @@index([chapterId])
  @@map("payment_transactions")
}

model LessonProgress {
  id        String   @id @default(uuid())
  studentId String
  lessonId  String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  student   User     @relation(fields: [studentId], references: [id])

  @@unique([studentId, lessonId])
  @@map("lesson_progress")
}

model LessonMaterial {
  id          String                   @id @default(cuid())
  lessonId    String
  filePath    String
  createdAt   DateTime                 @default(now())
  deletedAt   DateTime?
  displayName String
  fileSize    Int                      @default(0)
  mimeType    String                   @default("application/pdf")
  lesson      Lesson                   @relation(fields: [lessonId], references: [id])
  downloads   LessonMaterialDownload[]

  @@index([lessonId])
  @@map("lesson_materials")
}

model LessonMaterialDownload {
  id                String         @id @default(cuid())
  studentId         String         @map("student_id")
  materialId        String         @map("material_id")
  firstDownloadedAt DateTime       @default(now()) @map("first_downloaded_at")
  lastDownloadedAt  DateTime       @updatedAt @map("last_downloaded_at")
  student           User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  material          LessonMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([studentId, materialId])
  @@index([materialId])
  @@index([studentId])
  @@map("lesson_material_downloads")
}

model ContentChunk {
  id        String                       @id @default(uuid())
  content   String
  embedding Unsupported("vector(3072)")?
  lessonId  String
  metadata  Json                         @default("{}")
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt
  lesson    Lesson                       @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("content_chunks")
}

/// STORY-64: per-student daily AI-tutor query accounting. One row per student
/// per UTC calendar day; the unique constraint enables an atomic claim/refund so
/// concurrent requests cannot exceed AI_TUTOR_DAILY_QUERY_LIMIT.
model AiTutorUsage {
  id        String   @id @default(uuid())
  studentId String
  usageDate DateTime @db.Date
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, usageDate])
  @@index([studentId])
  @@map("ai_tutor_usage")
}

model AuditLog {
  id             String   @id @default(uuid())
  action         String
  resourceType   String
  resourceId     String
  details        Json?
  userId         String
  createdAt      DateTime @default(now())
  actorType      String?
  actorName      String?
  scopeTeacherId String?
  user           User     @relation(fields: [userId], references: [id])

  @@index([scopeTeacherId, createdAt])
  @@index([userId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  createdAt DateTime @default(now())
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Quiz {
  id                     String           @id @default(uuid())
  title                  String
  description            String?
  chapterId              String?
  contentScope           QuizContentScope @default(CHAPTER) @map("content_scope")
  status                 QuizStatus       @default(DRAFT)
  durationMinutes        Int?             @map("duration_minutes")
  questionCount          Int              @default(0)
  totalPoints            Int              @default(0)
  passingScore           Int?             @map("passing_score")
  createdBy              String
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  publishedAt            DateTime?
  questions              Question[]
  attempts               QuizAttempt[]
  quizLessons            QuizLesson[]
  progressionGateLessons Lesson[]         @relation("LessonProgressionQuiz")
  chapter                Chapter?         @relation(fields: [chapterId], references: [id])
  creator                User             @relation(fields: [createdBy], references: [id])

  @@index([chapterId, status])
  @@map("quizzes")
}

model QuizLesson {
  quizId   String
  lessonId String
  quiz     Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  lesson   Lesson @relation(fields: [lessonId], references: [id])

  @@id([quizId, lessonId])
  @@index([lessonId])
  @@map("quiz_lessons")
}

enum QuizContentScope {
  CHAPTER
  SELECTED_LESSONS
}

model Question {
  id            String       @id @default(uuid())
  quizId        String
  type          QuestionType
  text          String
  options       Json
  correctAnswer String?
  explanation   String?
  sortOrder     Int          @default(0)
  points        Int          @default(1)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([quizId, sortOrder])
  @@map("questions")
}

model QuizAttempt {
  id                      String                   @id @default(uuid())
  quizId                  String
  studentId               String
  answers                 Json
  score                   Float?
  totalPoints             Int                      @default(0)
  status                  AttemptStatus            @default(IN_PROGRESS)
  startedAt               DateTime                 @default(now())
  completedAt             DateTime?
  durationMinutesSnapshot Int?                     @map("duration_minutes_snapshot")
  expiresAt               DateTime?                @map("expires_at")
  submissionReason        AttemptSubmissionReason? @map("submission_reason")
  lastSavedAt             DateTime?                @map("last_saved_at")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  quiz                    Quiz                     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student                 User                     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([quizId, studentId])
  @@index([studentId])
  @@index([quizId])
  @@map("quiz_attempts")
}

model PromoCode {
  id              String    @id @default(uuid())
  code            String    @unique @db.VarChar(8)
  isUsed          Boolean   @default(false)
  usedByStudentId String?
  usedAt          DateTime?
  createdById     String
  chapterId       String
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?
  usedByStudent   User?     @relation("PromoCodeUsedBy", fields: [usedByStudentId], references: [id])
  createdBy       User      @relation("PromoCodeCreatedBy", fields: [createdById], references: [id])
  chapter         Chapter   @relation(fields: [chapterId], references: [id])

  @@index([usedByStudentId])
  @@index([createdById])
  @@index([chapterId])
  @@map("promo_codes")
}

enum Role {
  ADMIN
  STUDENT
  OPERATION
}

enum Status {
  ACTIVE
  INACTIVE
  BANNED
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  ESSAY
}

enum QuizStatus {
  DRAFT
  PUBLISHED
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  GRADED
}

enum AttemptSubmissionReason {
  MANUAL
  TIME_EXPIRED
}

enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum EnrollmentStatus {
  ACTIVE
  DEACTIVATED
  PAYMENT_PENDING
}

enum PaymentMethod {
  FREE
  PROMO
  PAYMOB
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

/// STORY-69 — persistent AI tutor conversations owned by a student.
model AiConversation {
  id         String      @id @default(uuid())
  studentId  String
  title      String      @default("محادثة جديدة")
  isArchived Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?
  student    User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  messages   AiMessage[]

  @@index([studentId, updatedAt])
  @@map("ai_conversations")
}

/// STORY-69 — persisted tutor chat messages (text + citation metadata).
model AiMessage {
  id              String          @id @default(uuid())
  conversationId  String
  role            AiMessageRole
  content         String
  status          AiMessageStatus @default(PENDING)
  citations       Json            @default("[]")
  clientMessageId String?
  errorCode       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  conversation    AiConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

enum AiMessageRole {
  STUDENT
  ASSISTANT
}

enum AiMessageStatus {
  PENDING
  COMPLETED
  FAILED
}
